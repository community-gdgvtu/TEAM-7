{
  "name": "panchayat-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Panchayat AI — AI-Powered Local Market Negotiation & Price Discovery Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
