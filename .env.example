# ==========================================
# PANCHAYAT AI — PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE CONFIGURATION (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.5rrxf0y.mongodb.net/panchayat_ai?retryWrites=true&w=majority
DATABASE_NAME=panchayat_ai

# 2. BACKEND FASTAPI SERVICE
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=your_production_jwt_secret_key_change_in_prod_32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. FRONTEND NEXT.JS / VITE CLIENT
VITE_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# 4. CORS ORIGINS (Comma-separated allowed origins)
ALLOWED_CORS_ORIGINS=http://localhost:5176,http://localhost:5173,http://localhost:3000,https://yourdomain.com

# 5. GOOGLE GEMINI AI LLM CONFIGURATION (Optional - Fallbacks to Rule Engine if omitted)
GEMINI_API_KEY=AQ.Ab8RN6JZJGYVeT5W0WOXfKvToA8tgWOkpCObehPbDH8vb0LkJA
GEMINI_MODEL=gemini-1.5-flash

# 6. DEMO MODE ENABLED
ENABLE_DEMO_MODE=true
