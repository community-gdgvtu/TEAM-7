# Panchayat AI Environment Configuration

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Database Configuration (Optional for Hackathon, local memory adapter available)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/panchayat_ai
REDIS_URL=redis://localhost:6379/0

# AI Provider API Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# App Settings
MAX_NEGOTIATION_ROUNDS=4
DEFAULT_CURRENCY=INR
DEFAULT_LOCATION=Hulkoti Market, Gadag
